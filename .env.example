# IRC Configuration
IRC_SERVER=irc.w3.org
IRC_PORT=6667
# example: #did-transcriber
IRC_CHANNEL="#your-channel"
IRC_BOT_NICK=transcriber-bot
IRC_BOT_USERNAME=transcriber
IRC_BOT_REALNAME=Meeting Transcription Bot

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Logging
LOG_LEVEL=info

# ── RTMS Gateway ──────────────────────────────────────────────────────────────
# OAuth app credentials from Zoom Marketplace (Server-to-Server or User-managed)
ZOOM_CLIENT_ID=get_from_zoom_marketplace
ZOOM_CLIENT_SECRET=get_from_zoom_marketplace
# Required by @zoom/rtms SDK (must match ZOOM_CLIENT_ID / ZOOM_CLIENT_SECRET above)
ZM_RTMS_CLIENT=get_from_zoom_marketplace
ZM_RTMS_SECRET=get_from_zoom_marketplace
# Secret token from the "Feature > Event Subscriptions" section of your Zoom app
ZOOM_SECRET_TOKEN=get_from_zoom_marketplace
# Port the webhook server listens on (must be publicly reachable by Zoom)
WEBHOOK_PORT=3000
# Path Zoom posts events to — set the same value in your Zoom app's event subscription URL
WEBHOOK_PATH=/webhook
# Full public URL for OAuth redirect (e.g. your ngrok URL + /oauth/callback)
# Must match exactly what's registered in your Zoom app's OAuth Redirect URL field
ZOOM_OAUTH_REDIRECT_URI=https://your-ngrok-url.ngrok-free.app/oauth/callback

# ── Legacy: Zoom Meeting SDK (kept for reference, not used by RTMS gateway) ──
# DEEPGRAM_API_KEY=your_api_key_here
# GATEWAY_WS_PORT=8080
# ZOOM_SDK_KEY=get_it_from_the_zoom_portal
# ZOOM_SDK_SECRET=get_it_from_the_zoom_portal
# ZOOM_SDK_SECRET_TOKEN=get_it_from_the_zoom_portal
# ZOOM_BOT_NAME="W3C Transcription Bot"
